{
  "schema": 1,
  "vocabularies": {
    "capability-bit": { "kind": "numeric", "entries": [ { "value": 0, "name": "Pki" }, { "value": 1, "name": "IdentityData" }, { "value": 2, "name": "EmrtdCrypto" }, { "value": 3, "name": "PinManagement" } ] },
    "cred-kind": { "kind": "token", "entries": [ "user", "sign", "puk", "can", "unknown" ] },
    "cred-outcome": { "kind": "token", "entries": [ "unspecified", "ok", "userCancelled", "missingFields", "invalidPin", "blocked", "pluginError", "unsupported", "keyActivationFailed", "cardRemoved" ] },
    "cred-recovery": { "kind": "token", "entries": [ "unknown", "holderViaPuk", "issuerProcess", "none" ] },
    "cred-state": { "kind": "token", "entries": [ "unknown", "transport", "operational", "needsChange", "blocked" ] },
    "cred-verb": { "kind": "token", "cddlOnly": true, "entries": [ "change", "unblock", "activate_pin" ] },
    "error-code": { "kind": "numeric", "entries": [ { "value": 0, "name": "None" }, { "value": 1, "name": "CardRemoved" }, { "value": 2, "name": "CredentialWrong" }, { "value": 3, "name": "CredentialBlocked" }, { "value": 4, "name": "CommunicationError" }, { "value": 5, "name": "ParseError" }, { "value": 6, "name": "UnsupportedCard" }, { "value": 7, "name": "AuthFailed" }, { "value": 8, "name": "PrompterError" }, { "value": 9, "name": "CapabilityMissing" }, { "value": 10, "name": "WatchdogTimeout" }, { "value": 11, "name": "KeyNotFound" }, { "value": 12, "name": "KeyAmbiguous" }, { "value": 13, "name": "CertExpiredBlocked" }, { "value": 14, "name": "ChainIncomplete" }, { "value": 15, "name": "TsaUnreachable" }, { "value": 16, "name": "SigningEngineError" }, { "value": 17, "name": "RateLimited" }, { "value": 18, "name": "EngineUnavailable" }, { "value": 19, "name": "InvalidDocument" } ] },
    "op-phase": { "kind": "numeric", "entries": [ { "value": 0, "name": "Created" }, { "value": 1, "name": "Connecting" }, { "value": 2, "name": "AwaitingConsent" }, { "value": 3, "name": "Authenticating" }, { "value": 4, "name": "Reading" }, { "value": 5, "name": "Signing" }, { "value": 6, "name": "Timestamping" }, { "value": 7, "name": "Done" } ] },
    "op-status": { "kind": "numeric", "entries": [ { "value": 0, "name": "Ok" }, { "value": 1, "name": "Cancelled" }, { "value": 2, "name": "Error" } ] },
    "packaging-mode": { "kind": "token", "entries": [ "enveloped", "detached" ] },
    "pre-read-auth": { "kind": "numeric", "entries": [ { "value": 0, "name": "None" }, { "value": 1, "name": "Mrz" }, { "value": 2, "name": "Can" } ] },
    "quiesce-reason": { "kind": "numeric", "entries": [ { "value": 0, "name": "SystemSleep" }, { "value": 1, "name": "ScreenLocked" }, { "value": 2, "name": "SessionInactive" }, { "value": 3, "name": "Shutdown" } ] },
    "settable-config-key": { "kind": "token", "cddlOnly": true, "entries": [ "DefaultLevel", "DefaultReason", "DefaultLocation", "TsaUrls", "TslSources" ] },
    "sign-format": { "kind": "token", "entries": [ "pades", "cades", "xades", "jades", "asice" ] },
    "sign-level": { "kind": "token", "entries": [ "b-b", "b-t", "b-lt", "b-lta" ] },
    "sync-error": { "kind": "token", "entries": [ "UnknownCard", "KeyNotFound", "NotAuthorized", "UserNotLoggedIn", "UnknownConfigKey", "ReadOnlyConfig", "InvalidConfigValue", "UnsupportedProtocol", "AuthFailed", "CommunicationError", "NotSupported", "UnsupportedOnThisCard", "UnsupportedSignatureParameter", "InputTooLarge", "RateLimited", "UnknownCredential", "InvalidRequest", "NoResult" ] },
    "unblock-style": { "kind": "token", "entries": [ "unknown", "resetOnly", "setsNewPin", "unblockAndChange" ] }
  }
}
