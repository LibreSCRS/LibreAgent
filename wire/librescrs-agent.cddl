; SPDX-License-Identifier: LGPL-2.1-or-later
; SPDX-FileCopyrightText: 2026 hirashix0
;
; LibreSCRS macOS agent socket wire contract — CBOR (RFC 8949) / CDDL (RFC 8610).
;
; Wire contract for the macOS agent socket transport. The canonical SEMANTIC
; source of truth is the D-Bus agent interface surface; this schema MIRRORS it
; for the socket transport and does NOT fork it — a shape that differs here is a
; bug in this file, not a dialect.
;
; Frame on the wire: uint32 little-endian body length + uint32 little-endian fd
; count + one `message` CBOR map. File descriptors (signed artifact, photo, sign
; input) ride SCM_RIGHTS ancillary data and are referenced from the body by `fd`
; (a 0-based index into the frame's fd vector); the fd-count header lets a
; streaming reader attribute exactly that many fds to each frame (the D-Bus
; UNIX_FDS approach). The socket is SOCK_CLOEXEC; set FD_CLOEXEC on each received
; fd via fcntl(fd, F_SETFD, FD_CLOEXEC) after recvmsg — MSG_CMSG_CLOEXEC is
; Linux-only, absent on Darwin. Frames larger than the max cap fail closed (the
; browser-loaded facade is untrusted).
; Encode with RFC 8949 §4.2 CORE DETERMINISTIC ENCODING (sorted map keys,
; shortest-form integers, no indefinite-length items) — the CTAP2 "canonical
; CBOR" rule — so the WireContractGuard byte-stable round-trip is meaningful and
; the wire is malleability-free. The reference codec is QCBOR (deterministic).

start = message
message = request / reply / event

; ---- shared value types ----
handle   = tstr                 ; opaque per-insertion reader/card handle (NOT the fingerprint)
cert-id  = tstr                 ; sha256hex(DER) of a signing certificate
fd-index = uint                 ; index into the frame's SCM_RIGHTS fd vector

capabilities   = uint .bits capability-bit
capability-bit = ( Pki: 0, IdentityData: 1, EmrtdCrypto: 2, PinManagement: 3 )   ; .bits RHS is a plain group
; Tolerance (client decode): pre-read-auth is wire-frozen append-only; a value
; past Can=2 (a future unlock method this client build does not name yet)
; MUST NOT fail the frame -- decode it through raw, numeric, unmodified. What
; an unrecognised value MEANS is a client-side concern, not the codec's: the
; card-property mapping (e.g. the socket transport's preAuthToken()) treats
; it the same as the default, None.
pre-read-auth  = &( None: 0, Mrz: 1, Can: 2 )
; Tolerance (client decode): op-phase and op-status are both wire-frozen
; append-only; a value past this build's last named one is a FUTURE value,
; not a malformed one -- decode it through raw. Degradation is decided by the
; STATEFUL client layer that consumes the decoded value, never the codec: an
; unrecognised op-phase still delivers the progress fraction but the public
; "current phase" holds the last known-good one instead of regressing to the
; unrecognised value (AgentOperation on the Qt client; the Swift mirror's
; OperationDriver); an unrecognised op-status is treated as Error.
op-phase  = &( Created: 0, Connecting: 1, AwaitingConsent: 2, Authenticating: 3,
               Reading: 4, Signing: 5, Timestamping: 6, Done: 7 )
op-status = &( Ok: 0, Cancelled: 1, Error: 2 )
; 21 stable, append-only values — MUST match LibreAgent's
; include/LibreSCRS/Agent/wire/ErrorCode.h.
; Tolerance (client decode): a value past EntryExpired=20 -- a code a newer
; agent appended -- decodes through raw (the ORIGINAL tolerance this wire
; shipped with; every other numeric enum above/below now follows the same
; rule). The client treats it as opaque display/log data and never branches
; on it.
error-code = &( None: 0, CardRemoved: 1, CredentialWrong: 2, CredentialBlocked: 3,
  CommunicationError: 4, ParseError: 5, UnsupportedCard: 6, AuthFailed: 7,
  PrompterError: 8, CapabilityMissing: 9, WatchdogTimeout: 10, KeyNotFound: 11,
  KeyAmbiguous: 12, CertExpiredBlocked: 13, ChainIncomplete: 14, TsaUnreachable: 15,
  SigningEngineError: 16, RateLimited: 17, EngineUnavailable: 18, InvalidDocument: 19,
  EntryExpired: 20 )

; ---- requests (client -> agent) ----
request  = { req: uint, req-body }
req-body = ( hello // get-state // read-identity // get-photo //
  read-certificates // read-token-info // sign // sign-batch // get-cert-der // get-config // set-config // reset-config //
  cancel-op // get-sign-result // pk-login // pk-logout // pk-public-key // pk-sign-raw // pk-decrypt //
  list-credentials // manage-pin // activate-signing-key // layout-visual // get-appearance-font //
  import-csca-master-list // forget-csca-anchors )

hello             = ( t: "Hello", proto: uint, ? client: tstr )
get-state         = ( t: "GetState" )
read-identity     = ( t: "ReadIdentity", card: handle )
get-photo         = ( t: "GetPhoto", card: handle )
read-certificates = ( t: "ReadCertificates", card: handle )
; Lightweight token-info read (PKCS#15 TokenInfo or equivalent). Result rides
; the EXISTING op-result-ready kind "Identity" (identity-result below) — a
; single "token" group: label/serial_number/manufacturer — never a new result
; shape. Gated behind the "token-info" hello-ack feature token (see
; hello-ack) + the PKI capability bit (token info is PKI-adjacent, the same
; gate read-certificates uses). An unsupported/best-effort-miss plugin
; answers a PRESENT "token" group with ZERO fields -- a SUCCESS, never an
; error (the spec's empty-group resilience).
read-token-info   = ( t: "ReadTokenInfo", card: handle )
; Card1.Sign: the document to sign rides SCM_RIGHTS (referenced by `in`).
sign              = ( t: "Sign", card: handle, cert: cert-id, in: fd-index, opts: sign-opts )
; Card1.SignBatch: N documents signed under ONE consent + credential prompt,
; sharing certId/opts across the whole batch (the same sign-opts a single
; Sign already uses, reused verbatim) -- only each document's identity/bytes
; vary per entry. Each document's bytes ride SCM_RIGHTS, referenced by
; fdIndex exactly like sign's single `in`. Entry validated to 1-12 documents
; (bounded by the bus's per-message fd budget, shared by this request's
; document fds and the Result signal's artifact fds); 0 or more than 12 is
; Error.InvalidRequest, no Operation minted. One consent covers the whole
; batch: the PIN is collected once and held agent-side only for the batch's
; duration, discarded once every document has been attempted. A wrong or
; blocked credential halts the remaining documents (they are not attempted;
; their row carries the SAME halt code) rather than re-prompting per file.
sign-batch        = ( t: "SignBatch", card: handle, cert: cert-id, docs: [* batch-document], opts: sign-opts )
batch-document    = { name: tstr, fdIndex: fd-index }
; Pkcs11_1 seam — ALL methods reader-addressed (the canonical Pkcs11_1 interface takes
; a reader object path + certId; the resolution seams are reader-path-keyed and
; the login lease is per-token/per-reader-slot). NO PIN args (protected-auth);
; Login raises the agent prompter on the first cold-lease SignRaw/Decrypt.
get-cert-der      = ( t: "GetCertDer", reader: handle, cert: cert-id )   ; public, no consent/lease
get-config        = ( t: "GetConfig" )                                  ; -> config (typed entries)
; Config1.ImportCscaMasterList: install country-signing trust anchors from a
; signed ICAO master list. The list rides SCM_RIGHTS (referenced by `list`)
; exactly like sign's `in` — a PLAIN descriptor, never a sealed memfd:
; master-list data is public, and sealing is this wire's vocabulary for
; secrets, so using it here would say something untrue about what is being
; handed over. It MUST be a regular file (or memfd); a pipe or socket is
; refused, because the agent reads it synchronously and an unbounded source
; would stall every other client.
;
; An import is a one-shot INPUT, not a source: nothing about the file is
; remembered as a place to fetch from, and the accepted anchors REPLACE the
; cached set (a master list is a complete statement of what its publisher
; vouches for, so merging would keep anchors it has withdrawn).
;
; Part of the Config1 family, and like get-config/set-config/reset-config it
; carries NO hello-ack feature gate. That is deliberate rather than an
; omission: the feature catalog (LibreSCRS::Agent::kAgentFeatures) is served
; VERBATIM by both hosts, so it cannot express "the bus host serves this and
; the socket host does not yet" — a token added for this family would make the
; socket host advertise a request it would then not answer, which is worse than
; the alternative. A socket host built against THIS contract but not yet
; implementing the family leaves the request unanswered and the client's
; bounded call reports the unreachable-agent class; a host predating the
; contract does not know the `t` tag at all and fails the frame closed, which
; is the same forward-compatibility cost every request family here carries and
; the reason a client and its socket host ship from one pin.
;
; Rejections (all named, err-info's `name`): NotAuthorized, RateLimited,
; InvalidRequest (not a regular file, or unreadable), InputTooLarge,
; NotAMasterList, EmptyMasterList, MalformedMasterList, BadMasterListSignature,
; MasterListSignerChanged, MasterListReplayed, AnchorCacheNotWritable. Only
; MasterListReplayed is in this wire's own `sync-error` group today (see its
; comment for why that one and not the rest); the others are agent-namespace
; names a client build that does not know them degrades to CommunicationError,
; under the same tolerance rule.
import-csca-master-list = ( t: "ImportCscaMasterList", list: fd-index )
; Config1.ForgetCscaAnchors: discard every country signing anchor this agent
; holds, and the publisher it follows with them. Answers `forgotten-anchors`.
;
; Carries NOTHING, and that is a contract statement rather than a simplification:
; there is one anchor store and this empties it. A key naming which publisher to
; forget would describe an operation that does not exist, because the rotation
; rule is applied against the whole set -- forgetting part of it leaves a store
; that refuses lists for a reason no surface could explain.
;
; WHY A VERB OF ITS OWN when reset-config already exists and would have added
; nothing to this vocabulary: the anchors and the pin live in the CACHE, not in
; the configuration, so a config reset does not reach them. It would clear the
; recorded REPORT and leave the anchors and the pin in place -- a surface saying
; nothing is installed while every later master list is still refused, which is
; the exact trap this verb exists to open, reintroduced with no trace.
;
; Same authorization as the import (org.librescrs.agent.configure.trust): it
; changes what this machine will believe about a travel document. Part of the
; Config1 family, so it carries NO hello-ack feature gate, for the reason spelled
; out under import-csca-master-list above.
;
; NO per-caller flood bound, unlike import-csca-master-list, and the asymmetry
; is deliberate: that bound exists because the import READS a descriptor the
; caller hands over, and a refused caller must not be able to make the agent
; read to the cap. This takes no input, unlinks three paths and is idempotent.
; Both hosts answer alike here, by agreement rather than by coincidence.
;
; Rejections (err-info's `name`): NotAuthorized, AnchorCacheNotWritable.
; Holding nothing is NOT a rejection: an agent that has imported nothing has
; already forgotten everything, and it answers zeros.
forget-csca-anchors = ( t: "ForgetCscaAnchors" )
set-config        = ( t: "SetConfig", key: settable-config-key, value: any )  ; Config1.SetValue; low vs trust tier
reset-config      = ( t: "ResetConfig", key: config-key )               ; Config1.Reset(key)
cancel-op         = ( t: "CancelOp", op: uint )
get-sign-result   = ( t: "GetSignResult", op: uint )                    ; recovery is Sign-ONLY (Sign1.GetResult)
pk-login          = ( t: "Pkcs11.Login",     reader: handle )                       ; reader-addressed
pk-logout         = ( t: "Pkcs11.Logout",    reader: handle )                       ; reader-addressed
pk-public-key     = ( t: "Pkcs11.PublicKey", reader: handle, cert: cert-id )        ; reader-addressed; RSA n/e (EC reserved)
pk-sign-raw       = ( t: "Pkcs11.SignRaw",   reader: handle, cert: cert-id, data: bstr )   ; reader-addressed
pk-decrypt        = ( t: "Pkcs11.Decrypt",   reader: handle, cert: cert-id, data: bstr )   ; reader-addressed
; Credentials1 seam — PIN/signing-key lifecycle. Gated behind the "credentials"
; hello-ack feature token (see hello-ack) and the PinManagement capability bit.
list-credentials     = ( t: "ListCredentials",    card: handle )
; pinId (NOT "pin" — this wire never carries a secret) = a record id
; from the most recent listing of this card; ids resolve against the
; agent's per-card snapshot regardless of which connection produced
; it. The agent never lists implicitly inside a mutation. activateKey
; is legal only with verb "activate_pin" (InvalidRequest otherwise);
; the closed option set is structural here (no open options container);
; unrecognized EXTRA map keys follow the wire-wide tolerant decode.
manage-pin           = ( t: "ManagePin",          card: handle, pinId: tstr,
                         verb: cred-verb, ? activateKey: bool )
activate-signing-key = ( t: "ActivateSigningKey", card: handle )
cred-verb = "change" / "unblock" / "activate_pin"
; Card-independent, synchronous visible-signature layout preview -- no
; card, no Operation object (unlike every request above). x/y/width/height
; mirror visual-sig-opts' rectangle field-for-field (PDF user units,
; float64); validated at method entry the SAME way (non-negative-free --
; there is no page here -- all four finite, width/height strictly positive),
; Error.InvalidRequest otherwise. Gated behind the "layout-preview" feature
; token (see hello-ack) -- client-side local refusal before the request is
; ever sent, mirroring tsaUrl/visualSignature's own posture.
layout-visual = ( t: "LayoutVisual", text: tstr, x: float64, y: float64, width: float64, height: float64 )
; The embedded appearance font (Liberation Sans Regular TTF) rides the SAME
; fd-index/SCM_RIGHTS mechanism as every other fd-carrying reply on this
; wire (sign-result's `artifact`, photo-result's `fd`) -- never inlined as
; `bstr`, so a client that never asks for it pays no bandwidth. Gated behind
; the "layout-preview" feature token, same as layout-visual above.
get-appearance-font = ( t: "GetAppearanceFont" )
; Card1.Sign options: format/level/packaging + optional per-sign chrome.
; tsaUrl overrides the agent's configured TSA (TsaUrls/LastTsaUrl) for THIS
; ONE sign (https-only, non-empty host — validated at method entry); absent
; uses the configured default. Meaningful only for the timestamped/long-term
; family — paired with level "b-b" it is rejected at entry, not silently
; ignored (Error.UnsupportedSignatureParameter). Gated behind the "tsa-url"
; feature token (client-side local refusal before the request is ever sent;
; unrelated to this grammar, which the agent still enforces server-side).
; visualSignature attaches a PAdES visible-signature appearance; rejected at
; method entry on any other format. Gated behind the "visual-sign" feature
; token, same posture as tsaUrl above.
; The three sign-option vocabularies, as CLOSED groups rather than bare tstr.
; Each has a resolved form (what a signature can actually be) and a requested
; form (what a client may ask for), because "auto" is REQUEST-ONLY: sign-meta
; always reports a concrete resolution and can never carry it.
; The agent enforces exactly these sets at method entry
; (SignatureParams::isKnownFormat / isKnownLevel / isKnownPackaging); the
; groups state what has always been enforced, they narrow nothing.
; "" is NOT a member: the socket frontend tolerates it for robustness, but no
; client in this stack emits it and it is not contractual.
;
; Only the three RESOLVED forms are closed groups the manifest carries. Each
; requested-* form names its resolved form plus the sentinel, which makes it a
; rule reference rather than a bare alternation, and the vocabulary reader
; deliberately reports only rules whose right-hand side is nothing but quoted
; literals. Spelling the four levels out a second time here to make the
; requested form "closed" too would reintroduce exactly the hand-copied
; vocabulary this manifest exists to eliminate.
sign-level          = "b-b" / "b-t" / "b-lt" / "b-lta"
requested-level     = sign-level / "auto"        ; "auto": the agent's configured DefaultLevel (+ its TSA-derived upgrade)
sign-format         = "pades" / "cades" / "xades" / "jades" / "asice"
requested-format    = sign-format / "auto"       ; "auto": sniffed from the document's leading bytes
; "enveloping" is deliberately absent -- it exists nowhere below the C++ agent
; client: not in isKnownPackaging, not in LibreMiddleware's PackagingMode, not
; in the signing engine.
packaging-mode      = "enveloped" / "detached"
requested-packaging = packaging-mode / "auto"    ; "auto": enveloped for PAdES/ASiC-E, detached otherwise
sign-opts     = { format: requested-format, level: requested-level, packaging: requested-packaging,
                  ? allowExpired: bool, ? displayName: tstr, ? reason: tstr, ? location: tstr,
                  ? tsaUrl: tstr, ? visualSignature: visual-sig-opts }
; page is 0-based; x/y/width/height are PDF user units (float64). All six
; fields are REQUIRED once visualSignature itself is present — only the outer
; sign-opts key is optional.
visual-sig-opts = { page: uint, x: float64, y: float64, width: float64, height: float64, text: tstr }

; Config1 is a TYPED property set. Only a SUBSET is settable over the wire;
; TslCacheDir/AiaCacheDir/PluginDir are file-only (a wire-settable PluginDir is a
; dlopen code-exec vector) and LastTsaUrl/CscaAnchorState are read-only agent
; state.
;
; CscaAnchorState is read-only for a stronger reason than LastTsaUrl's: it
; reports what country-signing anchors the agent HOLDS, so a client that could
; write it would be claiming what passports are checked against without
; installing a single anchor. Its value is the same dict ImportCscaMasterList
; replies with (csca-anchor-state below, minus the `kind` discriminator that
; only a reply arm needs), and it exists so a client that has just STARTED --
; one with no import reply to read -- can say what is installed instead of
; saying that it cannot be known. An EMPTY map means nothing has been
; imported; there is no "unconfigured" sentinel to misread.
;
; The agent's CscaCacheDir is file-only as well, and unlike those three it is not
; on this wire AT ALL -- no client reads or resets it, so it has no config-key
; spelling here. The PKCS#11 lease knobs are absent for the same reason: this
; group is the wire contract, not an inventory of the agent's config file.
;
; NOTE for the vocabulary manifest: settable-config-key is a CLOSED token
; alternation and is therefore published in wire/wire-vocabulary.json and
; guarded against the clients' mirrors. config-key is NOT -- its right-hand
; side names another rule, which the manifest reader deliberately reports as
; open -- so appending a read-only key here moves no manifest entry, and the
; drift guard that watches it is ConfigKeyMirrorTest's own probe list instead.
settable-config-key = "DefaultLevel" / "DefaultReason" / "DefaultLocation" /   ; low tier (configure)
                      "TsaUrls" / "TslSources" / "CscaSources"                 ; trust tier (configure.trust)
config-key = settable-config-key / "LastTsaUrl" / "CscaAnchorState" /
             "TslCacheDir" / "AiaCacheDir" / "PluginDir"

; ---- reply (agent -> client, correlated by req) ----
; A map member value must be a TYPE, not a group (RFC 8610 §3.5); the success
; result groups are merged into the reply map directly (discriminated by their
; own keys), the error case under the `err` key.
reply    = { t: "Reply", req: uint, ( reply-ok // ( err: err-info ) ) }
; Async-op failures carry the numeric ErrorCode; synchronous method failures
; (Pkcs11_1 / Config1 / Card1.Sign method-entry) carry a NAMED error. One or the
; other, never both.
err-info = { ( code: error-code // name: sync-error ), ? msgKey: tstr, ? msgFallback: tstr }
; Named synchronous-method errors (D-Bus Error.* names). Includes the Card1.Sign
; method-entry rejections (no Operation minted): UnsupportedOnThisCard,
; UnsupportedSignatureParameter, InputTooLarge, RateLimited. "NoResult" is
; GetSignResult's own dedicated dead-end: the op has no retained Sign result to
; serve (never completed as Sign, the recovery grace window elapsed, or the
; requester does not own it -- the last two are DELIBERATELY indistinguishable
; on the wire, an IDOR-safety rule, not a decode ambiguity). Pinned as a named
; classification (see the tolerance note just below for how a client maps it),
; not merely a fallback token.
; Tolerance (client decode): sync-error is a TEXT-token enum, unlike the
; numeric ones above -- there is no width to bound an unrecognised token
; against, so it DEGRADES AT DECODE to "CommunicationError" (the same
; generic-protocol-error bucket an unrecognised D-Bus error name already
; falls back to on the other transport) instead of failing the err-info map
; (and the whole reply frame) closed. The original token is not retained.
; This DEGRADE fallback is distinct from "NoResult"'s own classification --
; both a client that already knows "NoResult" and one that does not (an older
; build, pre-degrade) converge on the SAME CommunicationError outcome (see
; ErrorNameMap.cpp's mapAgentErrorShortName), so an older client cannot
; distinguish the two paths behaviourally either way.
; "MasterListReplayed" is ImportCscaMasterList's own refusal: the list is
; authentic and is NOT newer than the one already installed -- older, dated the
; same, or carrying no signing time while the installed one does. It is named
; rather than folded into InvalidRequest because it is the one import failure a
; person can act on directly ("you already have this list", "this one is older
; than what is installed"), and a caller that cannot tell it from a malformed
; file has to say nothing useful at the only moment saying something helps.
sync-error = "UnknownCard" / "KeyNotFound" / "NotAuthorized" / "UserNotLoggedIn" /
             "UnknownConfigKey" / "ReadOnlyConfig" / "InvalidConfigValue" / "UnsupportedProtocol" /
             "AuthFailed" / "CommunicationError" / "NotSupported" /
             "UnsupportedOnThisCard" / "UnsupportedSignatureParameter" /
             "InputTooLarge" / "RateLimited" / "UnknownCredential" / "InvalidRequest" / "NoResult" /
             "MasterListReplayed"
reply-ok = ( hello-ack // op-started // state // cert-list // cert-der // public-key //
             config // ack // raw-signature // sign-recovery // layout // appearance-font //
             csca-anchor-state // forgotten-anchors )
; `features` advertises optional request families this agent understands; the
; client MUST gate the credential requests (ListCredentials / ManagePin /
; ActivateSigningKey) on the "credentials" token and fall back to read-only when
; it is absent. This gate is mandatory, not advisory: the tolerant decode only
; skips unknown MAP KEYS within a known message — an unknown request `t:` tag has
; no such tolerance. An agent predating this contract has no "credentials" token
; and answers such a frame by failing it closed and dropping the connection, so a
; client that skips the gate loses its whole session instead of getting a clean
; per-request error.
; Feature-token vocabulary — the SET of tokens this agent may actually serve in
; `features`, single-sourced from LibreSCRS::Agent::kAgentFeatures
; (include/LibreSCRS/Agent/FeatureTokens.h) and served verbatim on both wires
; (this HelloAck field; the mirrored D-Bus `Manager1.Features` property).
; `features` stays the open `[* tstr]` below, NOT a closed CDDL enumeration —
; a client tolerates any EXTRA token a newer agent advertises (see the gate
; note above). This comment documents which tokens are actually LIVE today; a
; guard test (tests/wire/FeatureTokensGuardTest.cpp) keeps it and the array in
; lockstep, so an append to one without the other fails closed:
;   "credentials"
;   "card-type"
;   "token-info"
;   "trust-status"
;   "tsa-url"
;   "visual-sign"
;   "layout-preview"
;   "identity-stream"
;   "batch-sign"
hello-ack     = ( kind: "HelloAck", agentVer: tstr, features: [* tstr] )   ; agentVer<->Manager1.Version; features<->Manager1.Features
op-started    = ( op: uint )    ; async op id (ReadIdentity/GetPhoto/ReadCertificates/ReadTokenInfo/Sign/SignBatch/
                                ;   ListCredentials/ManagePin/ActivateSigningKey)
state         = ( readers: [* reader-state], cards: [* card-state] )
cert-list     = ( certs: [* cert-info] )
cert-der      = ( der: bstr )
public-key    = ( kty: "RSA", n: bstr, e: bstr //             ; RSA: modulus + public exponent (served)
                  kty: "EC",  crv: tstr, x: bstr, y: bstr )   ; EC reserved — not served in v0.1 (agent-ec-support)
config        = ( entries: { * config-key => any } )
ack           = ( ok: true )
raw-signature = ( sig: bstr )              ; Pkcs11.SignRaw / Decrypt result
sign-recovery = ( result: sign-result )    ; GetSignResult reply (Sign-only, within the grace window)
; LayoutVisual's reply. fontSize/lineHeight are PDF user units (float64,
; mirroring the request's own rectangle units); lines is the word-wrapped
; text, one entry per rendered line. `clipped` is PIXEL-PARITY load-bearing —
; see LibreSCRS::Signing::VisualSignatureLayout's own doc comment — true iff
; even the floor font size does not fit the box, in which case a renderer
; MUST install the same clip path the PAdES emitter installs when it stamps
; the real signature. Discriminated by `kind` like hello-ack (the only other
; reply-ok arm to use that key) rather than by a key unique to this arm alone
; — `kind: "Layout"` never collides with `kind: "HelloAck"`.
layout          = ( kind: "Layout", fontSize: float64, lineHeight: float64, lines: [* tstr], clipped: bool )
; GetAppearanceFont's reply — the embedded Liberation Sans Regular TTF
; bytes, ridden as an fd exactly like sign-result's `artifact` / photo-result's
; `fd` (never inlined as `bstr`).
appearance-font = ( fd: fd-index )
; ImportCscaMasterList's reply: what the agent now believes about its
; country-signing anchors. Mirrors the D-Bus `Config1.CscaAnchorState`
; property field-for-field — that interface is the canonical semantic source
; and this schema does not fork it. Discriminated by `kind`, like hello-ack and
; layout: this arm carries no key unique enough that a future arm could not
; also want it.
;
;   anchors              anchors held. INCLUDES CSCA link certificates, which
;                        are anchors like any other, so this is not a count of
;                        self-signed roots.
;   issuers              distinct issuing countries among those anchors.
;   replayRefusalActive  whether a later import can be refused for rolling the
;                        anchors back. Its FALSE is the value worth knowing: it
;                        means the accepted list carried no signing time, so
;                        "is this older than what I have" cannot be answered at
;                        all. REQUIRED for exactly that reason — a surface that
;                        stays silent leaves a person unable to tell "this is
;                        safe" from "this cannot be checked".
;   signer               lowercase hex SHA-256 over the publisher's
;                        SubjectPublicKeyInfo — the fingerprint a person is
;                        shown, and the value the next import is pinned to.
;   signerPinned         whether the import ESTABLISHED that publisher's
;                        identity (matched the fingerprint, or built a path to
;                        an anchor already held) rather than merely observing
;                        it. FALSE after a trust-on-first-import.
;   acceptedAt           seconds since the epoch when the AGENT accepted the
;                        list. Under no publisher's control.
;   signedAt             seconds since the epoch the list says it was SIGNED
;                        (the CMS signingTime attribute). ABSENT when the list
;                        carries none, which CMS permits; there is no zero
;                        sentinel, because a list signed at the epoch and a
;                        list with no date must not read alike.
;   origin               where the anchors came from ("import").
;
; The five optional members are optional HERE, not merely on the bus: the twin
; property is an untyped `a{sv}` with no schema to enforce them, and a client
; that failed a whole frame closed over a display-only field would be strictly
; less robust than its own D-Bus half, for no gain.
csca-anchor-state = ( kind: "CscaAnchorState", anchors: uint, issuers: uint,
                      replayRefusalActive: bool,
                      ? signer: tstr, ? signerPinned: bool,
                      ? acceptedAt: int, ? signedAt: int, ? origin: tstr )

; ForgetCscaAnchors' reply: what was DESTROYED, not what remains.
;
; Deliberately NOT csca-anchor-state, and the difference is the point. After a
; forget the state is ABSENT, and that arm cannot say so -- its `anchors` and
; `issuers` are required, so it would carry zeros, and a zeroed report means "a
; list was accepted and it vouched for nobody". That is a different claim and a
; false one, and it is the same distinction the agent keeps when it CLEARS a
; stale report instead of zeroing it.
;
; BOTH members required. This arm exists to state what went, so a member a
; decoder may find missing would make "nothing was there" and "the field was
; dropped" read alike. Zero is a real answer: an agent holding nothing forgets
; nothing and says so.
forgotten-anchors = ( kind: "ForgottenAnchors", anchorsForgotten: uint,
                      hadPinnedSigner: bool )

reader-state = { handle: handle, name: tstr, hasCard: bool, ? card: handle }
; cardType/atr are appended (feature-gated "card-type"): cardType is
; empty-until-known (absent from the map until the agent has a value — either
; the single-candidate pluginId resolved at the same deferred point as caps/
; preAuth, or the authoritative CardData::cardType from a completed read,
; pushed to an already-published card via a `property-changed` event carrying
; iface "org.librescrs.Agent.Card1" (see that event's own vocabulary comment
; below)); atr is uppercase hex, no separators, the full session ATR,
; always present from insertion onward. Both keys are OPTIONAL so an older
; client decoding a newer agent's frame (nothing to do here, append-only) and
; a newer client decoding an OLDER agent's frame (the keys are simply absent)
; both degrade to empty strings, never a decode failure.
card-state   = { handle: handle, reader: handle, caps: capabilities, preAuth: pre-read-auth,
                 ? cardType: tstr, ? atr: tstr }
; Mirror the canonical Certificates1.Result a(sba{sa{s(ssv)}}uasasu) grouped
; shape — grouped fields (group -> field -> [labelKey, labelFallback, value]) plus
; keyUsageBits, ekus, chainSubjectCns, trustStatus. No DER on the wire.
; `fields` group keys (dict-key growth is lawful and append-only on this
; map): subject | issuer | validity | publicKey | cert | ext |
; basicConstraints | san | ian | crlDp | aia | certificatePolicies | eku |
; security. One further group, "diagnostic", is emitted INSTEAD of all of
; the above (and alone) when the agent cannot parse a certificate's DER at
; all: it carries a single "parseError" field with the parser's own
; message, and the cert's signingCapable stays false with an empty
; chainSubjectCns. It is documented here rather than listed above because
; it is a failure channel, not part of the certificate vocabulary -- but a
; client decodes it through exactly the same generic path.
; The vocabulary-append extension groups (basicConstraints/san/ian/
; crlDp/aia/certificatePolicies) mirror LM's typed X.509 extension
; accessors (BasicConstraints/SubjectAltName/IssuerAltName/
; CRLDistributionPoints/AuthorityInfoAccess/CertificatePolicies); the
; generic "ext" group never duplicates an OID a typed group already
; decoded. Criticality reaches a client through TWO conventions, because
; an extension lands in one of two shapes and only one of them has a
; label on this wire:
;   - an extension served by a CELL carries the marker on that cell's
;     labelFallback, as a " (Critical)" suffix. That is the "ext" dump's
;     per-extension rows and the "cert" group's subjectKeyIdentifier /
;     authorityKeyIdentifier cells.
;   - an extension served by a whole typed GROUP (basicConstraints, san,
;     ian, crlDp, aia, certificatePolicies, eku) carries a "critical"
;     FIELD instead: cert-field ["", "Critical", "true"], present ONLY
;     when the extension is critical. A group has no label on this wire
;     -- `fields` is group KEY -> field -> cert-field -- so a marker on
;     the group's label would reach nobody; the empty labelKey is what
;     marks this cell as group metadata rather than a row to print.
;     Absent cell means not critical (or an agent that does not report
;     criticality); it is never emitted with a false value.
; `eku` is the ExtendedKeyUsage purposes rendered by NAME through the OID
; database, ordinal-keyed usage0/usage1/... and falling back to the
; dotted OID when the database has no entry; it does NOT replace the
; `ekus` member below, which stays the dotted list a caller matches on.
; `cert` also gained subjectKeyIdentifier /
; authorityKeyIdentifier (clean colon-hex, distinct from the raw
; ASN.1-wrapped extnValue "ext" would otherwise show for those two OIDs)
; and a signatureAlgorithm OID fallback for an unrecognised description.
; `security` is the trustStatus's own token vocabulary (see below), one
; field per token keyed by the token itself, value == the token.
; trustStatus: 0 Trusted, 1 UntrustedRoot, 2 BrokenChain,
; 3 InvalidCertificate, 4 Expired, 5 Revoked, 6 OfflineUnverified,
; 255 Unknown. Computed by the agent's TrustVerifier seam (LM
; Trust::TrustStore, configured from TslSources/TslCacheDir); no TSL
; source configured (or the trust store unavailable) yields 6
; OfflineUnverified. Revoked (5) is reserved vocabulary — no revocation
; (OCSP/CRL) check is wired yet, so the agent never emits it today.
; Matching security-status tokens (closed vocabulary: "trusted",
; "untrusted-root", "broken-chain", "invalid", "expired", "revoked",
; "offline-unverified") ride the "security" group.
; Tolerance (client decode): trustStatus is a raw u32, wire-frozen
; append-only like error-code above; a value past OfflineUnverified=6 --
; a verdict a newer agent appended -- decodes through raw and the client
; maps it to Unknown at the mapping layer, never failing the decode.
cert-info    = { certId: cert-id, signingCapable: bool,
                 fields: { * tstr => { * tstr => cert-field } },
                 keyUsageBits: uint, ekus: [* tstr], chainSubjectCns: [* tstr], trustStatus: uint }
cert-field   = [ labelKey: tstr, labelFallback: tstr, value: tstr ]   ; (ssv): value is UTF-8

; ---- events (agent -> client, unsolicited) ----
event = { reader-added // reader-removed // card-added // card-removed //
          property-changed // config-changed // op-progress // op-identity-group //
          op-result-ready // op-finished // agent-quiesced }
reader-added     = ( t: "ReaderAdded",   reader: reader-state )
reader-removed   = ( t: "ReaderRemoved", handle: handle )
card-added       = ( t: "CardAdded",     card: card-state )
card-removed     = ( t: "CardRemoved",   handle: handle )
; The wire SHAPE stays free-form (`iface: tstr, props: { * tstr => any }`) --
; append-tolerant like `features` above -- but only two interfaces actually
; ever emit this event today (the SOCKET daemon only; the D-Bus daemon uses
; its native org.freedesktop.DBus.Properties.PropertiesChanged signal per
; interface instead of this event, so this vocabulary has no D-Bus-side
; equivalent to cross-check against). A guard test
; (tests/wire/PropertyChangedVocabGuardTest.cpp) pins the iface SET below; an
; iface this comment does not list, or a listed one this comment drops, fails
; the guard. Per-iface `props` keys are documented here but NOT
; guard-tested (there is no single-sourced production array to pin them
; against, unlike `features`' kAgentFeatures) --
;   iface "org.librescrs.Agent.Card1": pushed when a card's cardType resolves
;     after insertion (see card-state's own comment above) --
;     props: { CardType: tstr }
;   iface "org.librescrs.Agent.Reader1": pushed on a reader's hasCard/card
;     transition --
;     props: { HasCard: bool, ? Card: tstr }  (Card present only when
;     HasCard is true)
property-changed = ( t: "PropertyChanged", handle: handle, iface: tstr, props: { * tstr => any } )
config-changed   = ( t: "ConfigChanged", key: config-key )   ; Config1.Changed(key) — client re-reads via GetConfig
; Operation1 progress properties: Phase + Progress/IsIndeterminate/WatchdogTimeoutSeconds.
op-progress = ( t: "OpProgress", op: uint, phase: op-phase,
                ? progress: float, ? indeterminate: bool, ? watchdogSecs: uint )
; The typed Result fires BEFORE Finished (canonical Operation1 ordering); a
; distinct op-result-ready event carries the payload, op-finished carries no result.
; Delivery invariant — a result cannot be missed by subscribing late, which is
; why op-result-ready needs no pull-based recovery and get-sign-result is
; Sign-only:
;   Every frame of an op (the op-started reply, op-progress, op-identity-group,
;   op-result-ready, op-finished) is written to the connection that issued the
;   request, in order, on one serial queue. Delivery eligibility is established
;   when the connection is accepted — before the request that starts the op is
;   parsed — so there is no separate subscription channel to arm afterwards and
;   nothing to race. A client that reads its socket late loses nothing: unread
;   frames stay queued. The result cannot overtake the op-started reply either,
;   because that reply is enqueued inside the same serial-queue block that
;   starts the op, and writes drain FIFO.
;   Losing the connection is not a late subscriber: it cancels the op and evicts
;   its recovery state, and a reconnect is issued a fresh connId/CallerToken, so
;   there is no cross-connection resume to serve.
; Progressive identity-read delivery: a ReadIdentity (or a GetPhoto cache-miss
; read, which never reaches this arm — see the field-group source's own doc
; comment) pushes ONE op-identity-group frame per field group as the card
; plugin produces it, all of them written — same serial queue, same ordering
; guarantee as above — strictly BEFORE the eventual op-result-ready for that
; op. A client that renders incrementally does not need to wait for the final
; grouped result; one that ignores this frame entirely still gets the
; complete set from op-result-ready, which stays authoritative and is
; unchanged by this event's existence — a group delivered here is a
; progressive hint, never a substitute for it. `fields` mirrors
; identity-result's own per-group map shape (the SAME id-field tuple), one
; group's worth rather than the whole grouped dict. Gated behind the
; "identity-stream" feature token (see hello-ack): an agent that does not
; advertise it never writes this frame at all; a client is not required to
; gate its OWN handling of it on the token (unlike every request-side gate
; above) because receiving an event needs no request to have been sent
; differently — the asymmetry is that this is push-only, not
; request/response. An older client build that does not recognise
; "OpIdentityGroup" at all skips it via the wire-wide unknown-`t`-tag
; tolerance, exactly like any other event it does not understand.
op-identity-group = ( t: "OpIdentityGroup", op: uint, groupKey: tstr,
                       fields: { * tstr => id-field } )
op-result-ready = ( t: "OpResultReady", op: uint, result: op-result )
op-finished = ( t: "OpFinished", op: uint, status: op-status, code: error-code,
                msgKey: tstr, msgFallback: tstr )
; system-lifecycle: the agent quiesced card access (sleep / lock / user-switch).
agent-quiesced = ( t: "AgentQuiesced", reason: quiesce-reason )
; Tolerance (client decode): quiesce-reason is wire-frozen append-only, like
; pre-read-auth; an unrecognised reason decodes through raw. Nothing on the
; client branches on the value today, so an unrecognised one is inertly a
; "generic quiesce" -- the event still degrades agent availability the same
; way regardless of which reason it names.
quiesce-reason = &( SystemSleep: 0, ScreenLocked: 1, SessionInactive: 2, Shutdown: 3 )

; ---- op result payloads (Sign also served by GetSignResult within the grace window) ----
op-result = identity-result / photo-result / cert-list-result / sign-result / sign-batch-result / credentials-result
; Mirror the canonical Identity1.Result a{sa{s(sssv)}} grouped 4-tuple
; (labelKey, labelFallback, type, value). Photo fields are omitted (fetch via GetPhoto).
identity-result  = { kind: "Identity",     fields: { * tstr => { * tstr => id-field } } }
id-field         = [ labelKey: tstr, labelFallback: tstr, type: tstr, value: tstr / bstr ]
photo-result     = { kind: "Photo",        photos: [* { key: tstr, fd: fd-index }] }  ; key = "group:field"
cert-list-result = { kind: "Certificates", certs: [* cert-info] }
sign-result      = { kind: "Sign",         artifact: fd-index, meta: sign-meta }
; The RESOLVED forms, never the requested ones: a result reports what was
; actually produced, so "auto" can never appear here.
sign-meta = { format: sign-format, level: sign-level, tsaUsed: bool, chainComplete: bool }
; SignBatch's result: one row per input document, in the SAME order. A
; successful row's `artifact` is the signed AdES bytes; a failed row's
; `artifact` is the wire's pinned zero-length-sealed-memfd convention (a
; non-nullable fd still resolves, to zero bytes) -- this grammar cannot
; distinguish the two by shape alone, that invariant is upheld by whichever
; layer seals the memfd. `errorCode` is None on a successful row; every row
; from the halt point onward (inclusive of the row that triggered it)
; carries the SAME halt code. Tolerance (client decode): errorCode is the
; same raw u32, wire-frozen append-only `error-code` as every other
; errorCode field on this wire -- an unrecognised value decodes through raw.
sign-batch-result = { kind: "SignBatch", rows: [* sign-batch-row] }
sign-batch-row    = { displayName: tstr, artifact: fd-index, meta: sign-meta, errorCode: error-code }

; Credentials results. A MUTATION op (ManagePin/ActivateSigningKey)
; emits EXACTLY ONE op-result-ready per operation — for EVERY completed
; attempt, including invalidPin/blocked/userCancelled — always BEFORE
; op-finished (one attempt per op; a retry is a new request); its
; records are always []. A LIST op likewise emits exactly one
; op-result-ready for every completed attempt; records are populated
; only on Ok (empty otherwise), always BEFORE op-finished.
; Ordering holds modulo channel allocation failure, which fails the op
; closed. No GetResult analog: the unicast-FIFO delivery invariant
; above removes the D-Bus late-subscribe race that justifies it.
; pinActivated/keyActivated presence: populated for the activate_pin
; bring-up continuation AND for activateSigningKey (partial bring-up =
; pinActivated=true, keyActivated=false, outcome keyActivationFailed).
credentials-result = { kind: "Credentials", result: cred-result,
                       records: [* cred-record] }
cred-result = { outcome: cred-outcome, ? retriesLeft: uint, blocked: bool,
                ? pinActivated: bool, ? keyActivated: bool }
; Tolerance (client decode): cred-outcome is a TEXT-token enum, exactly like
; sync-error above -- an unrecognised token DEGRADES AT DECODE to
; "unspecified" instead of failing the cred-result (and thus the whole
; op-result-ready) closed. The original token is not retained.
cred-outcome = "unspecified" / "ok" / "userCancelled" / "missingFields" /
               "invalidPin" / "blocked" / "pluginError" / "unsupported" /
               "keyActivationFailed" / "cardRemoved" / "entryExpired"
cred-record = { id: tstr, label: tstr, kind: cred-kind, state: cred-state,
                ? retriesLeft: uint, ? retriesMax: uint, ? usesLeft: uint,
                ? usesMax: uint, ? unblocksLeft: uint, ? minLength: uint, ? maxLength: uint,
                canChange: bool, unblockable: bool, unblockStyle: unblock-style,
                activatable: bool, keyActivationPending: bool,
                keyActivatable: bool, recovery: cred-recovery, probeSafe: bool,
                ? blockedGuidanceKey: tstr, ? blockedGuidanceFallback: tstr,
                ? keyActivationGuidanceKey: tstr,
                ? keyActivationGuidanceFallback: tstr }
cred-kind      = "user" / "sign" / "puk" / "can" / "unknown"
cred-state     = "unknown" / "transport" / "operational" / "needsChange" / "blocked"
unblock-style  = "unknown" / "resetOnly" / "setsNewPin" / "unblockAndChange"
cred-recovery  = "unknown" / "holderViaPuk" / "issuerProcess" / "none"
