; SPDX-License-Identifier: LGPL-2.1-or-later
; SPDX-FileCopyrightText: 2026 hirashix0
;
; LibreSCRS macOS agent socket wire contract — CBOR (RFC 8949) / CDDL (RFC 8610).
;
; Wire contract for the macOS agent socket transport. The canonical SEMANTIC
; source of truth is the D-Bus agent interface surface; this schema MIRRORS it
; for the socket transport and does NOT fork it — a shape that differs here is a
; bug in this file, not a dialect.
;
; Frame on the wire: uint32 little-endian body length + uint32 little-endian fd
; count + one `message` CBOR map. File descriptors (signed artifact, photo, sign
; input) ride SCM_RIGHTS ancillary data and are referenced from the body by `fd`
; (a 0-based index into the frame's fd vector); the fd-count header lets a
; streaming reader attribute exactly that many fds to each frame (the D-Bus
; UNIX_FDS approach). The socket is SOCK_CLOEXEC; set FD_CLOEXEC on each received
; fd via fcntl(fd, F_SETFD, FD_CLOEXEC) after recvmsg — MSG_CMSG_CLOEXEC is
; Linux-only, absent on Darwin. Frames larger than the max cap fail closed (the
; browser-loaded facade is untrusted).
; Encode with RFC 8949 §4.2 CORE DETERMINISTIC ENCODING (sorted map keys,
; shortest-form integers, no indefinite-length items) — the CTAP2 "canonical
; CBOR" rule — so the WireContractGuard byte-stable round-trip is meaningful and
; the wire is malleability-free. The reference codec is QCBOR (deterministic).

start = message
message = request / reply / event

; ---- shared value types ----
handle   = tstr                 ; opaque per-insertion reader/card handle (NOT the fingerprint)
cert-id  = tstr                 ; sha256hex(DER) of a signing certificate
fd-index = uint                 ; index into the frame's SCM_RIGHTS fd vector

capabilities   = uint .bits capability-bit
capability-bit = ( Pki: 0, IdentityData: 1, EmrtdCrypto: 2, PinManagement: 3 )   ; .bits RHS is a plain group
pre-read-auth  = &( None: 0, BacMrz: 1, PaceCan: 2 )
op-phase  = &( Created: 0, Connecting: 1, AwaitingConsent: 2, Authenticating: 3,
               Reading: 4, Signing: 5, Timestamping: 6, Done: 7 )
op-status = &( Ok: 0, Cancelled: 1, Error: 2 )
; 20 stable, append-only values — MUST match LibreAgent value/ErrorTaxonomy.h.
error-code = &( None: 0, CardRemoved: 1, CredentialWrong: 2, CredentialBlocked: 3,
  CommunicationError: 4, ParseError: 5, UnsupportedCard: 6, AuthFailed: 7,
  PrompterError: 8, CapabilityMissing: 9, WatchdogTimeout: 10, KeyNotFound: 11,
  KeyAmbiguous: 12, CertExpiredBlocked: 13, ChainIncomplete: 14, TsaUnreachable: 15,
  SigningEngineError: 16, RateLimited: 17, EngineUnavailable: 18, InvalidDocument: 19 )

; ---- requests (client -> agent) ----
request  = { req: uint, req-body }
req-body = ( hello // get-state // read-identity // get-photo //
  read-certificates // sign // get-cert-der // get-config // set-config // reset-config //
  cancel-op // get-sign-result // pk-login // pk-logout // pk-public-key // pk-sign-raw // pk-decrypt //
  list-credentials // manage-pin // activate-signing-key )

hello             = ( t: "Hello", proto: uint, ? client: tstr )
get-state         = ( t: "GetState" )
read-identity     = ( t: "ReadIdentity", card: handle )
get-photo         = ( t: "GetPhoto", card: handle )
read-certificates = ( t: "ReadCertificates", card: handle )
; Card1.Sign: the document to sign rides SCM_RIGHTS (referenced by `in`).
sign              = ( t: "Sign", card: handle, cert: cert-id, in: fd-index, opts: sign-opts )
; Pkcs11_1 seam — ALL methods reader-addressed (the canonical Pkcs11_1 interface takes
; a reader object path + certId; the resolution seams are reader-path-keyed and
; the login lease is per-token/per-reader-slot). NO PIN args (protected-auth);
; Login raises the agent prompter on the first cold-lease SignRaw/Decrypt.
get-cert-der      = ( t: "GetCertDer", reader: handle, cert: cert-id )   ; public, no consent/lease
get-config        = ( t: "GetConfig" )                                  ; -> config (typed entries)
set-config        = ( t: "SetConfig", key: settable-config-key, value: any )  ; Config1.SetValue; low vs trust tier
reset-config      = ( t: "ResetConfig", key: config-key )               ; Config1.Reset(key)
cancel-op         = ( t: "CancelOp", op: uint )
get-sign-result   = ( t: "GetSignResult", op: uint )                    ; recovery is Sign-ONLY (Sign1.GetResult)
pk-login          = ( t: "Pkcs11.Login",     reader: handle )                       ; reader-addressed
pk-logout         = ( t: "Pkcs11.Logout",    reader: handle )                       ; reader-addressed
pk-public-key     = ( t: "Pkcs11.PublicKey", reader: handle, cert: cert-id )        ; reader-addressed; RSA n/e (EC reserved)
pk-sign-raw       = ( t: "Pkcs11.SignRaw",   reader: handle, cert: cert-id, data: bstr )   ; reader-addressed
pk-decrypt        = ( t: "Pkcs11.Decrypt",   reader: handle, cert: cert-id, data: bstr )   ; reader-addressed
; Credentials1 seam — PIN/signing-key lifecycle. Gated behind the "credentials"
; hello-ack feature token (see hello-ack) and the PinManagement capability bit.
list-credentials     = ( t: "ListCredentials",    card: handle )
; pinId (NOT "pin" — this wire never carries a secret) = a record id
; from the most recent listing of this card; ids resolve against the
; agent's per-card snapshot regardless of which connection produced
; it. The agent never lists implicitly inside a mutation. activateKey
; is legal only with verb "activate_pin" (InvalidRequest otherwise);
; the closed option set is structural here (no open options container);
; unrecognized EXTRA map keys follow the wire-wide tolerant decode.
manage-pin           = ( t: "ManagePin",          card: handle, pinId: tstr,
                         verb: cred-verb, ? activateKey: bool )
activate-signing-key = ( t: "ActivateSigningKey", card: handle )
cred-verb = "change" / "unblock" / "activate_pin"
; Card1.Sign options: format/level/packaging + optional per-sign chrome.
; NO `tsa` — the TSA is Config1-owned (TsaUrls/LastTsaUrl), not a per-sign option.
sign-opts     = { format: tstr, level: tstr, packaging: tstr,
                  ? allowExpired: bool, ? displayName: tstr, ? reason: tstr, ? location: tstr }

; Config1 is a TYPED property set. Only a SUBSET is settable over the wire;
; TslCacheDir/AiaCacheDir/PluginDir are file-only (a wire-settable PluginDir is a
; dlopen code-exec vector) and LastTsaUrl is read-only agent state.
settable-config-key = "DefaultLevel" / "DefaultReason" / "DefaultLocation" /   ; low tier (configure)
                      "TsaUrls" / "TslSources"                                 ; trust tier (configure.trust)
config-key = settable-config-key / "LastTsaUrl" / "TslCacheDir" / "AiaCacheDir" / "PluginDir"

; ---- reply (agent -> client, correlated by req) ----
; A map member value must be a TYPE, not a group (RFC 8610 §3.5); the success
; result groups are merged into the reply map directly (discriminated by their
; own keys), the error case under the `err` key.
reply    = { t: "Reply", req: uint, ( reply-ok // ( err: err-info ) ) }
; Async-op failures carry the numeric ErrorCode; synchronous method failures
; (Pkcs11_1 / Config1 / Card1.Sign method-entry) carry a NAMED error. One or the
; other, never both.
err-info = { ( code: error-code // name: sync-error ), ? msgKey: tstr, ? msgFallback: tstr }
; Named synchronous-method errors (D-Bus Error.* names). Includes the Card1.Sign
; method-entry rejections (no Operation minted): UnsupportedOnThisCard,
; UnsupportedSignatureParameter, InputTooLarge, RateLimited.
sync-error = "UnknownCard" / "KeyNotFound" / "NotAuthorized" / "UserNotLoggedIn" /
             "UnknownConfigKey" / "ReadOnlyConfig" / "InvalidConfigValue" / "UnsupportedProtocol" /
             "AuthFailed" / "CommunicationError" / "NotSupported" /
             "UnsupportedOnThisCard" / "UnsupportedSignatureParameter" /
             "InputTooLarge" / "RateLimited" / "UnknownCredential" / "InvalidRequest"
reply-ok = ( hello-ack // op-started // state // cert-list // cert-der // public-key //
             config // ack // raw-signature // sign-recovery )
; `features` advertises optional request families this agent understands; the
; client MUST gate the credential requests (ListCredentials / ManagePin /
; ActivateSigningKey) on the "credentials" token and fall back to read-only when
; it is absent. This gate is mandatory, not advisory: the tolerant decode only
; skips unknown MAP KEYS within a known message — an unknown request `t:` tag has
; no such tolerance. An agent predating this contract has no "credentials" token
; and answers such a frame by failing it closed and dropping the connection, so a
; client that skips the gate loses its whole session instead of getting a clean
; per-request error.
hello-ack     = ( kind: "HelloAck", agentVer: tstr, features: [* tstr] )   ; Manager1.Version
op-started    = ( op: uint )    ; async op id (ReadIdentity/GetPhoto/ReadCertificates/Sign/
                                ;   ListCredentials/ManagePin/ActivateSigningKey)
state         = ( readers: [* reader-state], cards: [* card-state] )
cert-list     = ( certs: [* cert-info] )
cert-der      = ( der: bstr )
public-key    = ( kty: "RSA", n: bstr, e: bstr //             ; RSA: modulus + public exponent (served)
                  kty: "EC",  crv: tstr, x: bstr, y: bstr )   ; EC reserved — not served in v0.1 (agent-ec-support)
config        = ( entries: { * config-key => any } )
ack           = ( ok: true )
raw-signature = ( sig: bstr )              ; Pkcs11.SignRaw / Decrypt result
sign-recovery = ( result: sign-result )    ; GetSignResult reply (Sign-only, within the grace window)

reader-state = { handle: handle, name: tstr, hasCard: bool, ? card: handle }
card-state   = { handle: handle, reader: handle, caps: capabilities, preAuth: pre-read-auth }
; Mirror the canonical Certificates1.Result a(sba{sa{s(ssv)}}uasasu) grouped
; shape — grouped fields (group -> field -> [labelKey, labelFallback, value]) plus
; keyUsageBits, ekus, chainSubjectCns, trustStatus. No DER on the wire.
cert-info    = { certId: cert-id, signingCapable: bool,
                 fields: { * tstr => { * tstr => cert-field } },
                 keyUsageBits: uint, ekus: [* tstr], chainSubjectCns: [* tstr], trustStatus: uint }
cert-field   = [ labelKey: tstr, labelFallback: tstr, value: tstr ]   ; (ssv): value is UTF-8

; ---- events (agent -> client, unsolicited) ----
event = { reader-added // reader-removed // card-added // card-removed //
          property-changed // config-changed // op-progress // op-result-ready //
          op-finished // agent-quiesced }
reader-added     = ( t: "ReaderAdded",   reader: reader-state )
reader-removed   = ( t: "ReaderRemoved", handle: handle )
card-added       = ( t: "CardAdded",     card: card-state )
card-removed     = ( t: "CardRemoved",   handle: handle )
property-changed = ( t: "PropertyChanged", handle: handle, iface: tstr, props: { * tstr => any } )
config-changed   = ( t: "ConfigChanged", key: config-key )   ; Config1.Changed(key) — client re-reads via GetConfig
; Operation1 progress properties: Phase + Progress/IsIndeterminate/WatchdogTimeoutSeconds.
op-progress = ( t: "OpProgress", op: uint, phase: op-phase,
                ? progress: float, ? indeterminate: bool, ? watchdogSecs: uint )
; The typed Result fires BEFORE Finished (canonical Operation1 ordering); a
; distinct op-result-ready event carries the payload, op-finished carries no result.
; Delivery invariant — a result cannot be missed by subscribing late, which is
; why op-result-ready needs no pull-based recovery and get-sign-result is
; Sign-only:
;   Every frame of an op (the op-started reply, op-progress, op-result-ready,
;   op-finished) is written to the connection that issued the request, in order,
;   on one serial queue. Delivery eligibility is established when the connection
;   is accepted — before the request that starts the op is parsed — so there is no
;   separate subscription channel to arm afterwards and nothing to race. A client
;   that reads its socket late loses nothing: unread frames stay queued. The
;   result cannot overtake the op-started reply either, because that reply is
;   enqueued inside the same serial-queue block that starts the op, and writes
;   drain FIFO.
;   Losing the connection is not a late subscriber: it cancels the op and evicts
;   its recovery state, and a reconnect is issued a fresh connId/CallerToken, so
;   there is no cross-connection resume to serve.
op-result-ready = ( t: "OpResultReady", op: uint, result: op-result )
op-finished = ( t: "OpFinished", op: uint, status: op-status, code: error-code,
                msgKey: tstr, msgFallback: tstr )
; system-lifecycle: the agent quiesced card access (sleep / lock / user-switch).
agent-quiesced = ( t: "AgentQuiesced", reason: quiesce-reason )
quiesce-reason = &( SystemSleep: 0, ScreenLocked: 1, SessionInactive: 2, Shutdown: 3 )

; ---- op result payloads (Sign also served by GetSignResult within the grace window) ----
op-result = identity-result / photo-result / cert-list-result / sign-result / credentials-result
; Mirror the canonical Identity1.Result a{sa{s(sssv)}} grouped 4-tuple
; (labelKey, labelFallback, type, value). Photo fields are omitted (fetch via GetPhoto).
identity-result  = { kind: "Identity",     fields: { * tstr => { * tstr => id-field } } }
id-field         = [ labelKey: tstr, labelFallback: tstr, type: tstr, value: tstr / bstr ]
photo-result     = { kind: "Photo",        photos: [* { key: tstr, fd: fd-index }] }  ; key = "group:field"
cert-list-result = { kind: "Certificates", certs: [* cert-info] }
sign-result      = { kind: "Sign",         artifact: fd-index, meta: sign-meta }
sign-meta = { format: tstr, level: tstr, tsaUsed: bool, chainComplete: bool }

; Credentials results. A MUTATION op (ManagePin/ActivateSigningKey)
; emits EXACTLY ONE op-result-ready per operation — for EVERY completed
; attempt, including invalidPin/blocked/userCancelled — always BEFORE
; op-finished (one attempt per op; a retry is a new request); its
; records are always []. A LIST op likewise emits exactly one
; op-result-ready for every completed attempt; records are populated
; only on Ok (empty otherwise), always BEFORE op-finished.
; Ordering holds modulo channel allocation failure, which fails the op
; closed. No GetResult analog: the unicast-FIFO delivery invariant
; above removes the D-Bus late-subscribe race that justifies it.
; pinActivated/keyActivated presence: populated for the activate_pin
; bring-up continuation AND for activateSigningKey (partial bring-up =
; pinActivated=true, keyActivated=false, outcome keyActivationFailed).
credentials-result = { kind: "Credentials", result: cred-result,
                       records: [* cred-record] }
cred-result = { outcome: cred-outcome, ? retriesLeft: uint, blocked: bool,
                ? pinActivated: bool, ? keyActivated: bool }
cred-outcome = "unspecified" / "ok" / "userCancelled" / "missingFields" /
               "invalidPin" / "blocked" / "pluginError" / "unsupported" /
               "keyActivationFailed" / "cardRemoved"
cred-record = { id: tstr, label: tstr, kind: cred-kind, state: cred-state,
                ? retriesLeft: uint, ? retriesMax: uint, ? usesLeft: uint,
                ? usesMax: uint, ? unblocksLeft: uint, ? minLength: uint, ? maxLength: uint,
                canChange: bool, unblockable: bool, unblockStyle: unblock-style,
                activatable: bool, keyActivationPending: bool,
                keyActivatable: bool, recovery: cred-recovery, probeSafe: bool,
                ? blockedGuidanceKey: tstr, ? blockedGuidanceFallback: tstr,
                ? keyActivationGuidanceKey: tstr,
                ? keyActivationGuidanceFallback: tstr }
cred-kind      = "user" / "sign" / "puk" / "can" / "unknown"
cred-state     = "unknown" / "transport" / "operational" / "needsChange" / "blocked"
unblock-style  = "unknown" / "resetOnly" / "setsNewPin" / "unblockAndChange"
cred-recovery  = "unknown" / "holderViaPuk" / "issuerProcess" / "none"
