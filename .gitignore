/build*/
/install*/
*.user

# makepkg by-products. The patterns above are root-anchored, so an in-tree
# `makepkg` leaves src/, pkg/ and the fetched/built tarballs untracked and a
# later `git add packaging/` would sweep them into a commit.
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.tar.gz
/packaging/arch/*.pkg.tar.*
