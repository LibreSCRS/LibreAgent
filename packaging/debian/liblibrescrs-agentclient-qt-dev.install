usr/lib/*/liblibrescrs-agentclient-qt.so
# A glob on the per-configuration export file, never the literal
# -relwithdebinfo the Arch recipe can name: debhelper builds with
# CMAKE_BUILD_TYPE=None on purpose, so the file here is …Targets-none.cmake and
# a literal name would match nothing at all, silently.
usr/lib/*/cmake/LibreAgent/LibreAgentClientQtTargets*.cmake
usr/include/LibreSCRS/AgentClient/
