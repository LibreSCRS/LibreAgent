# Maintainer: hirashix0 <hirashix0@proton.me>
#
# LibreAgent — the smart-card agent's platform-neutral library, split into
# three packages.
#
# WHERE THIS SITS IN THE CHAIN
# ----------------------------
# The chain is
#
#     librescrs-middleware  <=  libreagent  <=  librelinux  <=  librekde
#
# where `librescrs-agent` — the running D-Bus daemon — is one of the packages
# built from pkgbase `librelinux`. THESE are a different thing: the library
# side, owned by the LibreAgent repository. A Qt/KDE front-end needs both, the
# daemon it talks to at runtime and the client library it links.
#
# WHY THREE PACKAGES AND NOT TWO
# ------------------------------
# LibreAgentConfig.cmake and LibreAgentConfigVersion.cmake are installed
# UNCONDITIONALLY from every configuration (cmake/InstallExport.cmake), so one
# of the component packages has to own them. Making either component depend on
# the other is what the two-package shape would require, and that drags Qt into
# the agent's dependency closure or the middleware into every Qt client's —
# which is exactly what this recipe exists to refuse.
#
# A third, dependency-free package holding the shared contract is the smallest
# split that avoids both. It was not a guess: a naive two-way split was built
# and offered to pacman, which refused it on exactly the fifteen files the two
# halves would both have owned.
#
# WHAT EACH PACKAGE HOLDS
# -----------------------
# The payload is declared in packaging/payload/*.files rather than spelled out
# in the package functions, and packaging/arch/check-split.sh compares those
# lists with a real staged install: everything installed is claimed, nothing is
# claimed twice, and a pattern that matches nothing is an error. Two things are
# easy to leave out by hand and fail only at the CONSUMER, one release later —
# the per-configuration export files, which the main targets file picks up with
# a glob where an empty match is not an error, and the vendored codec's licence,
# whose objects are linked into both the core archive and the client library.
#
# VENDORED QCBOR
# --------------
# The wire layer's CBOR codec is QCBOR, pinned by immutable commit SHA and
# fetched by CMake's FetchContent. It is not in the Arch repositories and a
# clean chroot has no network during build(), so its tarball is a source entry
# below and FETCHCONTENT_SOURCE_DIR_QCBOR + FETCHCONTENT_FULLY_DISCONNECTED=ON
# point the build at the extracted tree instead of letting FetchContent reach
# the network. QCBOR's objects are folded into both the wire archive and the
# shared client library, so its BSD-3-Clause licence travels with both.

pkgbase=libreagent
pkgname=('librescrs-agent-common' 'librescrs-agent-core' 'librescrs-agent-client-qt')
pkgver=5.0.0
pkgrel=1
arch=('x86_64')
url="https://github.com/LibreSCRS/LibreAgent"
license=('LGPL-2.1-or-later' 'BSD-3-Clause')   # BSD-3 = vendored QCBOR
# Build host tooling. base-devel ships none of the first three.
makedepends=(
    'cmake>=3.28'   # FetchContent_Declare(... EXCLUDE_FROM_ALL) — which keeps
                    #   QCBOR's own install rules out of these packages — is a
                    #   no-op below 3.28, silently, with no configure warning
    'ninja'
    'git'           # cmake/GitVersion.cmake does find_package(Git REQUIRED)
                    #   unconditionally; without it configure fails outright
    'qt6-base'      # Qt6 Core/DBus/Test is a configure-time find_package()
    'gtest'         # the client test suite does find_package(GTest REQUIRED)
    'dbus'          # CONFIGURE-time, not merely check-time: the client test
                    #   CMakeLists does find_program(dbus-run-session REQUIRED)
    'librescrs-middleware>=5.0'  # LibreAgent::Core links LibreSCRS::* and needs
                                 #   its CMake config package at configure time
    'openssl'
)
options=('!lto')   # built in a clean chroot with LTO off; not measured to be required

_srcname="LibreAgent-$pkgver"
# The immutable SHA that QCBOR's (mutable) v1.6.1 tag resolves to. Must stay in
# lockstep with GIT_TAG in cmake/FetchQCBOR.cmake — that file is what the build
# would otherwise fetch, and FETCHCONTENT_SOURCE_DIR_QCBOR below silently
# overrides it, so a drift between the two would ship a different codec than
# the source tree pins. prepare() enforces that lockstep; see its comment.
_qcbor_commit=930708bb86481e88879eb1d87fd4d664f1d69503

source=(
    "$pkgbase-$pkgver.tar.gz::https://github.com/LibreSCRS/LibreAgent/releases/download/$pkgver/libreagent_$pkgver.orig.tar.gz"
    "qcbor-$_qcbor_commit.tar.gz::https://github.com/laurencelundblade/QCBOR/archive/$_qcbor_commit.tar.gz"
)
# The downloaded name is derived from $pkgbase, not $pkgname: in a split recipe
# pkgname is an ARRAY, so $pkgname would silently expand to its first element
# and name the tarball after one of the three packages.
#
# LibreAgent's own tarball is 'SKIP': the release that carries it does not
# exist yet, so there is nothing to fetch or sum. The real sum is filled in at
# tag time with `makepkg -g` (pacman's own tool; `updpkgsums` needs
# pacman-contrib), and packaging/arch/check-recipe.sh turns a remaining SKIP
# into an error once the tag exists. Until then the recipe is smoke-built
# against a tarball of the working tree placed next to this file under exactly
# the name above — makepkg reuses an already-present source file instead of
# downloading it, so the recipe itself needs no edit to be built today.
# QCBOR's sum is real and pinned now; that tarball exists upstream already.
sha256sums=(
    'SKIP'
    '0da68ac55f6e67c67e57f4fe4603b850713ce2b0ac95fb76094f446139db4d57'
)

# Two values above are hard-coded copies of facts that actually live in the
# source tree: _qcbor_commit mirrors GIT_TAG in cmake/FetchQCBOR.cmake, and
# pkgver mirrors the top-level VERSION file. Nothing outside this directory
# checks either copy, and both drift silently rather than loudly:
#
#   * FETCHCONTENT_SOURCE_DIR_QCBOR in build() overrides GIT_TAG with NO
#     warning, so bumping QCBOR in the source tree without bumping this recipe
#     would compile the OLD codec into the package while the sources say
#     otherwise — a wrong-binary bug with no signal anywhere.
#   * pkgver only labels the package. The installed
#     lib/cmake/LibreAgent/LibreAgentConfigVersion.cmake is generated from
#     VERSION, so a release bump that misses this recipe ships a package
#     called 4.2.0 whose own CMake version file disagrees with it.
#
# So the recipe verifies itself against the sources it is building, before it
# compiles anything. Every failure mode is a FAILURE, never a silent pass: a
# missing file, an unparseable value, a renamed CMake keyword, and a genuine
# mismatch all abort here. Each check derives its value from a strict pattern
# and then requires exactly one match, so a pattern that stops matching (the
# classic vacuous-check bug) fails the same way a real mismatch does.
#
# Both are verified rather than derived. pkgver has to be assignable when
# makepkg PARSES the recipe — before any source is fetched or extracted — so
# reading it out of $srcdir/VERSION is not possible, and a pkgver() function
# (the VCS-package mechanism) would make makepkg rewrite this committed file
# in place, which a release recipe must not do.
prepare() {
    local root="$srcdir/$_srcname"

    # --- QCBOR pin lockstep ---------------------------------------------
    local fetch_module="$root/cmake/FetchQCBOR.cmake"
    if [[ ! -f $fetch_module ]]; then
        printf '%s\n' \
            "PACKAGING GUARD: cannot verify the QCBOR pin." \
            "  Expected the FetchContent declaration at ${fetch_module#"$srcdir"/}, which is missing." \
            "  Refusing to build rather than silently trusting _qcbor_commit=$_qcbor_commit." >&2
        return 1
    fi
    local -a declared_tags
    mapfile -t declared_tags < <(sed -nE \
        's/^[[:space:]]*GIT_TAG[[:space:]]+([0-9a-f]{40})[[:space:]]*$/\1/p' "$fetch_module")
    if (( ${#declared_tags[@]} != 1 )); then
        printf '%s\n' \
            "PACKAGING GUARD: cannot verify the QCBOR pin." \
            "  ${fetch_module#"$srcdir"/} must contain exactly one 'GIT_TAG <40-hex>' line;" \
            "  found ${#declared_tags[@]}. The declaration was probably renamed or reshaped," \
            "  which would leave this check matching nothing and passing vacuously." >&2
        return 1
    fi
    if [[ ${declared_tags[0]} != "$_qcbor_commit" ]]; then
        printf '%s\n' \
            "PACKAGING GUARD: QCBOR pin drift — this package would ship the wrong codec." \
            "  ${fetch_module#"$srcdir"/} declares GIT_TAG        ${declared_tags[0]}" \
            "  this recipe pins                _qcbor_commit=$_qcbor_commit" \
            "  Update _qcbor_commit, the source= URL and sha256sums together." >&2
        return 1
    fi

    # --- pkgver vs the source tree's VERSION -----------------------------
    local version_file="$root/VERSION"
    if [[ ! -f $version_file ]]; then
        printf '%s\n' \
            "PACKAGING GUARD: cannot verify pkgver." \
            "  Expected ${version_file#"$srcdir"/}, which is missing — that file is what" \
            "  cmake/GitVersion.cmake falls back to in a tarball build, so without it the" \
            "  installed CMake version file and pkgver cannot be shown to agree." >&2
        return 1
    fi
    # Mirror GitVersion.cmake exactly: first line, stripped, optional leading 'v'.
    local declared_version
    declared_version=$(sed -n '1p' "$version_file")
    declared_version=${declared_version//[$'\t\r\n ']/}
    declared_version=${declared_version#v}
    if [[ ! $declared_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf '%s\n' \
            "PACKAGING GUARD: cannot verify pkgver." \
            "  First line of ${version_file#"$srcdir"/} is not a semantic version:" \
            "  '${declared_version}'" >&2
        return 1
    fi
    if [[ $declared_version != "$pkgver" ]]; then
        printf '%s\n' \
            "PACKAGING GUARD: version drift — the package label and the sources disagree." \
            "  ${version_file#"$srcdir"/} says  $declared_version" \
            "  this recipe says       pkgver=$pkgver" \
            "  A package labelled $pkgver would install a ConfigVersion.cmake saying $declared_version." >&2
        return 1
    fi

    printf '%s\n' \
        "  -> packaging guards passed: QCBOR pin $_qcbor_commit, version $declared_version"
}

build() {
    cd "$srcdir/$_srcname"
    # Every component ON, once. The three packages are carved out of a single
    # staged install below, so a component left OFF here does not produce a
    # smaller package — it produces a package whose payload list matches
    # nothing, and check-split.sh says so.
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLIBREAGENT_BUILD_CORE=ON \
        -DLIBREAGENT_BUILD_WIRE=ON \
        -DLIBREAGENT_BUILD_CLIENT_QT=ON \
        -DLIBREAGENT_BUILD_PKCS11_FACADE=ON \
        -DLIBREAGENT_BUILD_PKCS11_SOCKET_CLIENT=ON \
        -DLIBREAGENT_INSTALL_WIRE_ARCHIVE=ON \
        -DFETCHCONTENT_SOURCE_DIR_QCBOR="$srcdir/QCBOR-$_qcbor_commit" \
        -DFETCHCONTENT_FULLY_DISCONNECTED=ON
    cmake --build build -j4
}

check() {
    cd "$srcdir/$_srcname"
    # Qt needs a headless platform plugin. No bus is set up here on purpose:
    # every suite that needs one already wraps its own add_test() command in
    # dbus-run-session, which gives each suite a private session bus.
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -j4
}

# --- shared staging -----------------------------------------------------------
# One install tree, carved into three packages by the lists under
# packaging/payload/. Those are the same lists packaging/arch/check-split.sh
# compares against a real staged install in both directions.
_stage_once() {
    local stage="$srcdir/stage"
    if [ ! -d "$stage" ]; then
        rm -rf "$stage"
        DESTDIR="$stage" cmake --install build
    fi
}

# _install_payload <payload-name>
#
# Copies everything the named list claims out of the staged tree into $pkgdir.
# Symlinks are copied AS symlinks: a shared library ships as the real file plus
# the two SONAME links, and a package holding the file without the links
# installs cleanly and links nothing.
#
# A pattern that expands to nothing is an ERROR, not a satisfied line. SOVERSION
# follows PROJECT_VERSION_MAJOR, so the client library's file names move with
# every major release; a literal name would ship nothing at all, silently, the
# first time the major changed.
_install_payload() {
    local list="$srcdir/$_srcname/packaging/payload/$1.files"
    local stage="$srcdir/stage"
    local pattern hit rel n

    [ -f "$list" ] || { echo "packaging: payload list $list is missing" >&2; return 1; }

    while IFS= read -r pattern || [ -n "$pattern" ]; do
        case "$pattern" in ''|'#'*) continue;; esac
        n=0
        while IFS= read -r hit; do
            [ -e "$hit" ] || [ -L "$hit" ] || continue
            rel=${hit#"$stage"/usr/}
            install -d "$pkgdir/usr/$(dirname "$rel")" || return 1
            cp -a "$hit" "$pkgdir/usr/$rel" || return 1
            n=$((n + 1))
        done < <(compgen -G "$stage/usr/$pattern" || true)
        if [ "$n" -eq 0 ]; then
            echo "packaging: '$pattern' in $1.files matches nothing in the staged tree" >&2
            return 1
        fi
    done < "$list"
}

# _install_licences — every package carries both texts. QCBOR's objects are
# linked into the wire archive AND into the client library, so its licence
# cannot travel with only one of them; the shared-contract package carries them
# too because a user may install it alone.
_install_licences() {
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/QCBOR-$_qcbor_commit/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE.qcbor"
}

# --- librescrs-agent-common: the shared contract ------------------------------
package_librescrs-agent-common() {
    pkgdesc="Shared CMake package, public headers and wire contract for the LibreSCRS smart-card agent"
    # `any`: measured, not assumed — this package holds no ELF and nothing else
    # architecture-dependent. Anything naming its built file must therefore glob
    # the suffix rather than spell -x86_64.
    arch=('any')
    depends=()
    # Until this release the whole library shipped as one package named
    # librescrs-agent-client-qt, which owned the config files this package now
    # owns. Without this, an upgrade would put two owners on the same paths and
    # pacman would refuse the transaction with "exists in filesystem".
    conflicts=('librescrs-agent-client-qt<5.0.0')
    cd "$srcdir/$_srcname"

    _stage_once
    _install_payload common
    _install_licences
}

# --- librescrs-agent-core: the platform-neutral agent brain -------------------
package_librescrs-agent-core() {
    pkgdesc="Platform-neutral core library, wire codec and PKCS#11 facade for the LibreSCRS smart-card agent"
    depends=(
        'librescrs-agent-common'
        'librescrs-middleware>=5.0'
        'openssl'
        'gcc-libs'
        'glibc'
    )
    cd "$srcdir/$_srcname"

    _stage_once
    _install_payload core
    _install_licences
}

# --- librescrs-agent-client-qt: the Qt client library -------------------------
package_librescrs-agent-client-qt() {
    pkgdesc="Qt client library for the LibreSCRS smart-card agent (D-Bus and AF_UNIX socket transports)"
    # The core package is a dependency because this one ships the
    # ClientQtTestSupport CMake component, whose exported target links
    # LibreAgent::Wire, and Wire is in the core package. Without it
    # find_package(LibreAgent COMPONENTS ClientQtTestSupport) fails on a
    # machine with only this package installed. Arch has no separate
    # development package to carry that edge, so the runtime package does.
    depends=(
        'librescrs-agent-common'
        'librescrs-agent-core'  # LibreAgent::Wire, linked by ClientQtTestSupport
        'qt6-base'      # Qt6::Core (PUBLIC) and Qt6::DBus (PRIVATE, Linux transport)
        'gcc-libs'
        'glibc'
    )
    cd "$srcdir/$_srcname"

    _stage_once
    _install_payload client-qt
    _install_licences
}
