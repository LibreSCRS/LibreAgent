# SPDX-License-Identifier: LGPL-2.1-or-later
#
# CMake Config-package template for LibreAgent. Substituted into
# LibreAgentConfig.cmake by configure_package_config_file(); the result
# is installed to ${CMAKE_INSTALL_LIBDIR}/cmake/LibreAgent/ alongside the
# matching Version file and the per-component LibreAgent<Component>Targets.cmake
# exports — only the ones actually enabled at build time (LIBREAGENT_BUILD_CORE
# / _WIRE / _CLIENT_QT) are present on disk, so this file probes for each
# before including it.
#
# Downstream consumers (the platform backends and packagers) pull the package
# in via:
#   find_package(LibreAgent 4.2 REQUIRED CONFIG COMPONENTS Core)
# and link against the namespaced LibreAgent::<Component> imported target(s).
#
# Resolution is filtered by what the caller actually asked for
# (LibreAgent_FIND_COMPONENTS, set by CMake whenever find_package(...
# COMPONENTS ...) is used): a request for just ClientQt runs only ClientQt's
# find_dependency() call (Qt6) and never touches Core's
# (LibreMiddleware/OpenSSL), even if a LibreAgentCoreTargets.cmake happens to
# also be sitting in this same directory (e.g. two components of one
# distribution unpacked into a shared prefix) — its presence on disk must not
# matter to a consumer that never asked for it. A componentless
# find_package(LibreAgent CONFIG) call keeps today's behaviour: every
# component whose export file is on disk is probed and its dependencies
# resolved, same as before this filtering existed.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Probe every known component's export file rather than assuming all three
# are present: a package installed from a configuration with, say, only
# LIBREAGENT_BUILD_CORE=ON ships just LibreAgentCoreTargets.cmake, and this
# loop must not fail just because LibreAgentWireTargets.cmake /
# LibreAgentClientQtTargets.cmake do not exist on disk.
#
# Loop/scratch variables below are prefixed _LibreAgent_ rather than given
# generic names: find_package()/find_dependency() include the located
# Config.cmake or Find<Pkg>.cmake in THIS scope (no new variable scope), and
# CMake's bundled FindOpenSSL.cmake module happens to use — and unset() — a
# local variable literally named "_comp". A generically-named loop variable
# here would be silently clobbered by that find_dependency(OpenSSL ...) call
# below before the include() line runs.
set(_LibreAgent_known_components Core Wire ClientQt Pkcs11Facade Pkcs11SocketClient TestSupport)

# A componentless caller (LibreAgent_FIND_COMPONENTS unset/empty) probes every
# known component, exactly as before; a caller that named components gets only
# those, so an unrequested component's find_dependency() calls never run and
# its Targets.cmake is never include()'d, regardless of what else happens to
# be installed alongside it.
if(LibreAgent_FIND_COMPONENTS)
    set(_LibreAgent_components_to_resolve ${LibreAgent_FIND_COMPONENTS})
else()
    set(_LibreAgent_components_to_resolve ${_LibreAgent_known_components})
endif()

foreach(_LibreAgent_comp IN LISTS _LibreAgent_components_to_resolve)
    set(_LibreAgent_comp_targets_file "${CMAKE_CURRENT_LIST_DIR}/LibreAgent${_LibreAgent_comp}Targets.cmake")
    if(EXISTS "${_LibreAgent_comp_targets_file}")
        if(_LibreAgent_comp STREQUAL "Pkcs11Facade")
            # No find_dependency: this component links nothing. What it does
            # need is the function that links it correctly, because linking the
            # archive by bare name produces a module with no entry point.
            set(LIBREAGENT_PKCS11_EXPORTS_MAP
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/librescrs/pkcs11/exports.map")
            set(LIBREAGENT_PKCS11_EXPORTS_SYMBOLS
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/librescrs/pkcs11/exports.symbols")
            include("${CMAKE_CURRENT_LIST_DIR}/Pkcs11ModuleExport.cmake")
        elseif(_LibreAgent_comp STREQUAL "Core")
            # Re-expose the PUBLIC card stack (LibreSCRS::SmartCard /
            # ::Plugin) and the PRIVATE seam-only deps (::Certificate,
            # ::Signing, ::Trust, OpenSSL::Crypto) the static archive carries
            # transitively, so consumers do not re-discover them.
            find_dependency(LibreMiddleware 4.2 REQUIRED CONFIG)
            find_dependency(OpenSSL 3.0 REQUIRED COMPONENTS Crypto)
        elseif(_LibreAgent_comp STREQUAL "ClientQt")
            # Re-discover only the PUBLIC Qt6::Core this target was built
            # against, mirroring Core's block above. Qt6::DBus is linked
            # PRIVATE, and LibreAgentClientQt is SHARED (not STATIC like
            # Wire's folded-in qcbor, see that target's own comment in the
            # root CMakeLists.txt) -- a PRIVATE link of a SHARED library is
            # NOT re-exported to consumers as an INTERFACE_LINK_LIBRARIES
            # target requirement at all (verified: LibreAgentClientQtTargets.cmake's
            # INTERFACE_LINK_LIBRARIES carries only "Qt6::Core"; DBus surfaces
            # solely as the advisory, non-target IMPORTED_LINK_DEPENDENT_LIBRARIES_<CONFIG>
            # string property, used for the .so's own RPATH/dependency
            # bookkeeping, not resolved as a CMake target by find_package()).
            # The runtime dependency on libQt6DBus is instead carried as an
            # ordinary DT_NEEDED entry inside liblibrescrs-agentclient-qt.so
            # itself, resolved by the dynamic linker when that .so loads --
            # a consumer's own build never needs Qt6::DBus to exist as a
            # CMake target, so requiring it here would be a false hard
            # dependency (confirmed empirically: a consumer configures and
            # links fine with only Core found).
            find_dependency(Qt6 REQUIRED COMPONENTS Core)
        elseif(_LibreAgent_comp STREQUAL "TestSupport")
            # The fixture archive mints certificates with OpenSSL directly and
            # links it PUBLIC, so the imported target names OpenSSL::Crypto in
            # its INTERFACE_LINK_LIBRARIES. Re-discover it here or the consumer
            # resolves a target that names one it does not have.
            find_dependency(OpenSSL 3.0 REQUIRED COMPONENTS Crypto)
        endif()
        include("${_LibreAgent_comp_targets_file}")
        set(LibreAgent_${_LibreAgent_comp}_FOUND TRUE)
    else()
        set(LibreAgent_${_LibreAgent_comp}_FOUND FALSE)
    endif()
endforeach()
unset(_LibreAgent_comp)
unset(_LibreAgent_comp_targets_file)
unset(_LibreAgent_known_components)
unset(_LibreAgent_components_to_resolve)

# Name what is missing before refusing. check_required_components() sets
# LibreAgent_FOUND to FALSE and stops there, so CMake's own message says only
# that the config file set FOUND to FALSE -- true, and useless to the person
# reading it, who then has to guess which component their package lacks. A
# refusal that does not say what it refused is barely better than the silent
# disappearance this component mechanism exists to replace.
foreach(_LibreAgent_missing_comp IN LISTS LibreAgent_FIND_COMPONENTS)
    if(NOT LibreAgent_${_LibreAgent_missing_comp}_FOUND
       AND LibreAgent_FIND_REQUIRED_${_LibreAgent_missing_comp})
        list(APPEND _LibreAgent_missing ${_LibreAgent_missing_comp})
    endif()
endforeach()
if(_LibreAgent_missing)
    list(JOIN _LibreAgent_missing ", " _LibreAgent_missing_text)
    set(LibreAgent_NOT_FOUND_MESSAGE
        "this LibreAgent package was built without the requested component(s): ${_LibreAgent_missing_text}")
    unset(_LibreAgent_missing_text)
endif()
unset(_LibreAgent_missing)
unset(_LibreAgent_missing_comp)

check_required_components(LibreAgent)
